{
  "name": "dsh-archived-sessions",
  "version": "1.0.0",
  "description": "设置面板新增「已归档会话」页：列出全部已归档会话并一键恢复（取消归档）。Settings page listing archived sessions with one-click restore.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.2-rc.1"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "archive",
    "session",
    "settings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiongyishun666-alt/dsh-archived-sessions.git"
  },
  "homepage": "https://github.com/xiongyishun666-alt/dsh-archived-sessions#readme",
  "bugs": {
    "url": "https://github.com/xiongyishun666-alt/dsh-archived-sessions/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
